<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChatConversationViewer.ViewModels"
        xmlns:models="using:ChatConversationViewer.Models"
        xmlns:ctrl="using:ChatConversationViewer.Controls"
        xmlns:conv="using:ChatConversationViewer.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="ChatConversationViewer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200" Height="800"
        Title="Claude Conversation Viewer">

  <Grid ColumnDefinitions="380,5,*">

    <!-- Left: tree of projects and conversations -->
    <DockPanel Grid.Column="0" Margin="8">
      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="4">
        <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"/>
          <CheckBox Content="Show subagent (sidechain) messages"
                    IsChecked="{Binding ShowSidechains}"
                    VerticalAlignment="Center"/>
        </DockPanel>
      </StackPanel>

      <TreeView ItemsSource="{Binding Projects}"
                SelectedItem="{Binding SelectedNode}">
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="vm:ProjectNode" x:DataType="vm:ProjectNode" ItemsSource="{Binding Sessions}">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <Ellipse Width="9" Height="9" Fill="#D97757" VerticalAlignment="Center"
                       ToolTip.Tip="Claude Code" IsVisible="{Binding HasClaude}"/>
              <Ellipse Width="9" Height="9" Fill="#14B8A6" VerticalAlignment="Center"
                       ToolTip.Tip="OpenCode" IsVisible="{Binding HasOpenCode}"/>
              <Ellipse Width="9" Height="9" Fill="#8250DF" VerticalAlignment="Center"
                       ToolTip.Tip="Copilot (VS Code)" IsVisible="{Binding HasCopilotChat}"/>
              <Ellipse Width="9" Height="9" Fill="#24292F" VerticalAlignment="Center"
                       ToolTip.Tip="Copilot CLI" IsVisible="{Binding HasCopilotCli}"/>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="3,0,0,0"
                         ToolTip.Tip="{Binding SourceName}"/>
            </StackPanel>
          </TreeDataTemplate>
          <TreeDataTemplate DataType="vm:SessionNode" x:DataType="vm:SessionNode">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
              <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                       Fill="{Binding Source, Converter={x:Static conv:SourceBrushConverter.Instance}}"
                       ToolTip.Tip="{Binding SourceName}"/>
              <StackPanel>
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxWidth="300"
                           ToolTip.Tip="{Binding SessionId}"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6"/>
              </StackPanel>
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.DataTemplates>
      </TreeView>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#22000088"/>

    <!-- Right: conversation detail -->
    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" Margin="8">
      <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding CurrentSession.Title, FallbackValue='Select a conversation'}"
                     FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !!CurrentSession}">
            <Border CornerRadius="3" Padding="5,1"
                    Background="{Binding CurrentSession.Source, Converter={x:Static conv:SourceBrushConverter.Instance}}">
              <TextBlock Text="{Binding CurrentSession.SourceName}" FontSize="10" Foreground="White"/>
            </Border>
            <TextBlock Text="{Binding CurrentSession.Location}" FontSize="11" Opacity="0.6"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Content="Export Markdown…" Command="{Binding ExportCommand}"
                VerticalAlignment="Top"/>
      </Grid>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.DataTemplates>

            <!-- User message -->
            <DataTemplate DataType="models:UserTextEntry" x:DataType="models:UserTextEntry">
              <Border Background="#224A7BD5" CornerRadius="6" Padding="10" Margin="0,4">
                <StackPanel Spacing="4">
                  <DockPanel>
                    <TextBlock Text="User" FontWeight="SemiBold"/>
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                               Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                               FontSize="11" Opacity="0.6"/>
                    <TextBlock Text="subagent" FontSize="10" Opacity="0.6" Margin="8,0,0,0"
                               IsVisible="{Binding IsSidechain}"/>
                  </DockPanel>
                  <ctrl:MarkdownTextBlock Markdown="{Binding Text}"/>
                </StackPanel>
              </Border>
            </DataTemplate>

            <!-- Assistant text -->
            <DataTemplate DataType="models:AssistantTextEntry" x:DataType="models:AssistantTextEntry">
              <Border Background="#14008080" CornerRadius="6" Padding="10" Margin="0,4">
                <StackPanel Spacing="4">
                  <DockPanel>
                    <TextBlock Text="Assistant" FontWeight="SemiBold"/>
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                               Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                               FontSize="11" Opacity="0.6"/>
                    <TextBlock Text="subagent" FontSize="10" Opacity="0.6" Margin="8,0,0,0"
                               IsVisible="{Binding IsSidechain}"/>
                  </DockPanel>
                  <ctrl:MarkdownTextBlock Markdown="{Binding Text}"/>
                </StackPanel>
              </Border>
            </DataTemplate>

            <!-- Thinking -->
            <DataTemplate DataType="models:ThinkingEntry" x:DataType="models:ThinkingEntry">
              <Border Background="#229B59B6" CornerRadius="6" Padding="10" Margin="0,4">
                <Expander>
                  <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="💭 Thinking" FontStyle="Italic" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                 FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                      <TextBlock Text="subagent" FontSize="10" Opacity="0.6" VerticalAlignment="Center"
                                 IsVisible="{Binding IsSidechain}"/>
                    </StackPanel>
                  </Expander.Header>
                  <ctrl:MarkdownTextBlock Markdown="{Binding Thinking}" FontStyle="Italic" Opacity="0.9"/>
                </Expander>
              </Border>
            </DataTemplate>

            <!-- Tool call -->
            <DataTemplate DataType="models:ToolUseEntry" x:DataType="models:ToolUseEntry">
              <Border Background="#1F808080" CornerRadius="6" Padding="10" Margin="0,4">
                <Expander IsExpanded="True">
                  <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name, StringFormat='🔧 {0}'}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                 FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                      <TextBlock Text="subagent" FontSize="10" Opacity="0.6" VerticalAlignment="Center"
                                 IsVisible="{Binding IsSidechain}"/>
                    </StackPanel>
                  </Expander.Header>
                  <ctrl:MarkdownTextBlock Markdown="{Binding InputAsMarkdown}"/>
                </Expander>
              </Border>
            </DataTemplate>

            <!-- Tool result -->
            <DataTemplate DataType="models:ToolResultEntry" x:DataType="models:ToolResultEntry">
              <Border CornerRadius="6" Padding="10" Margin="0,4"
                      Background="#14808080"
                      Classes.error="{Binding IsError}">
                <Border.Styles>
                  <Style Selector="Border.error">
                    <Setter Property="Background" Value="#40C04040"/>
                  </Style>
                </Border.Styles>
                <Expander>
                  <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="📄 Tool result" FontWeight="SemiBold"/>
                      <TextBlock Text="⚠ error" Foreground="#FF8080" FontWeight="SemiBold"
                                 VerticalAlignment="Center" IsVisible="{Binding IsError}"/>
                      <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                 FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                      <TextBlock Text="subagent" FontSize="10" Opacity="0.6" VerticalAlignment="Center"
                                 IsVisible="{Binding IsSidechain}"/>
                    </StackPanel>
                  </Expander.Header>
                  <Panel>
                    <ctrl:MarkdownTextBlock Markdown="{Binding ContentAsMarkdown}"
                                            IsVisible="{Binding IsMarkup}"/>
                    <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                         FontFamily="Consolas, Menlo, Monospace" FontSize="12"
                                         IsVisible="{Binding !IsMarkup}"/>
                  </Panel>
                </Expander>
              </Border>
            </DataTemplate>

          </ItemsControl.DataTemplates>
        </ItemsControl>
      </ScrollViewer>

      <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" Margin="0,6,0,0"
                   IsVisible="{Binding IsLoading}"/>
    </Grid>
  </Grid>
</Window>
