<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChatConversationViewer.ViewModels"
        xmlns:conv="using:ChatConversationViewer.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="ChatConversationViewer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200" Height="800"
        Title="Claude Conversation Viewer">

  <Grid ColumnDefinitions="380,5,*">

    <!-- Left: search, tree of projects and conversations -->
    <DockPanel Grid.Column="0" Margin="8">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" Margin="4,0,0,0">
          <ToggleButton IsChecked="{Binding MatchCase}" Content="Aa"
                        ToolTip.Tip="Match case" Padding="5,2"/>
          <ToggleButton IsChecked="{Binding WholeWord}" ToolTip.Tip="Match whole word" Padding="5,2">
            <TextBlock Text="ab" TextDecorations="Underline"/>
          </ToggleButton>
        </StackPanel>
        <TextBox Text="{Binding SearchText}" PlaceholderText="Search conversations…">
          <TextBox.InnerRightContent>
            <Button Content="✕" Command="{Binding ClearSearchCommand}"
                    ToolTip.Tip="Clear search" Padding="3,1"
                    Background="Transparent" BorderThickness="0"
                    IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </TextBox.InnerRightContent>
        </TextBox>
      </DockPanel>

      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="4">
        <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"/>
          <CheckBox Content="Show subagent (sidechain) messages"
                    IsChecked="{Binding ShowSidechains}"
                    VerticalAlignment="Center"/>
        </DockPanel>
      </StackPanel>

      <Grid>
        <!-- while searching, the matches replace the tree, grouped per project (tree labels) -->
        <ScrollViewer IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <ItemsControl ItemsSource="{Binding SearchGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SearchGroupNode">
                <StackPanel Margin="0,0,0,10">
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="11" Opacity="0.7"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
                  <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SessionNode">
                        <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenSessionCommand}"
                                CommandParameter="{Binding}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="4,2,0,2" Background="Transparent" BorderThickness="0">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{Binding Source, Converter={x:Static conv:SourceBrushConverter.Instance}}"
                                     ToolTip.Tip="{Binding SourceName}"/>
                            <StackPanel>
                              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxWidth="300"
                                         ToolTip.Tip="{Binding SessionId}"/>
                              <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TreeView ItemsSource="{Binding Projects}"
                  SelectedItem="{Binding SelectedNode}"
                  IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNullOrEmpty}}">
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="vm:ProjectNode" x:DataType="vm:ProjectNode" ItemsSource="{Binding Sessions}">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <Ellipse Width="9" Height="9" Fill="#D97757" VerticalAlignment="Center"
                       ToolTip.Tip="Claude Code" IsVisible="{Binding HasClaude}"/>
              <Ellipse Width="9" Height="9" Fill="#14B8A6" VerticalAlignment="Center"
                       ToolTip.Tip="OpenCode" IsVisible="{Binding HasOpenCode}"/>
              <Ellipse Width="9" Height="9" Fill="#8250DF" VerticalAlignment="Center"
                       ToolTip.Tip="Copilot (VS Code)" IsVisible="{Binding HasCopilotChat}"/>
              <Ellipse Width="9" Height="9" Fill="#24292F" VerticalAlignment="Center"
                       ToolTip.Tip="Copilot CLI" IsVisible="{Binding HasCopilotCli}"/>
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="3,0,0,0"
                         ToolTip.Tip="{Binding DirectoryPath}"/>
            </StackPanel>
          </TreeDataTemplate>
          <TreeDataTemplate DataType="vm:DirectoryNode" x:DataType="vm:DirectoryNode" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="3,0,0,0"/>
          </TreeDataTemplate>
          <TreeDataTemplate DataType="vm:SessionNode" x:DataType="vm:SessionNode">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
              <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                       Fill="{Binding Source, Converter={x:Static conv:SourceBrushConverter.Instance}}"
                       ToolTip.Tip="{Binding SourceName}"/>
              <StackPanel>
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxWidth="300"
                           ToolTip.Tip="{Binding SessionId}"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6"/>
              </StackPanel>
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.DataTemplates>
        </TreeView>
      </Grid>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#22000088"/>

    <!-- Right: conversation detail -->
    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" Margin="8">
      <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding CurrentSession.Title, FallbackValue='Select a conversation'}"
                       FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <Button FontSize="10" Padding="6,2" VerticalAlignment="Top"
                    Command="{Binding CopyTitleCommand}"
                    IsVisible="{Binding CurrentSession, Converter={x:Static ObjectConverters.IsNotNull}}"
                    ToolTip.Tip="Copy title to clipboard">
              <Path Width="11" Height="15" Stretch="Uniform"
                    Data="M14 2 H5 V17 M8 7 H17 V22 H8 Z"
                    Stroke="{Binding $parent[Button].Foreground}"
                    StrokeThickness="0.7"/>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !!CurrentSession}">
            <Border CornerRadius="3" Padding="5,1"
                    Background="{Binding CurrentSession.Source, Converter={x:Static conv:SourceBrushConverter.Instance}}">
              <TextBlock Text="{Binding CurrentSession.SourceName}" FontSize="10" Foreground="White"/>
            </Border>
            <TextBlock Text="{Binding CurrentSession.Location}" FontSize="11" Opacity="0.6"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button FontSize="10" Padding="6,2" VerticalAlignment="Center"
                    Command="{Binding CopyLocationCommand}"
                    ToolTip.Tip="Copy location to clipboard">
              <Path Width="11" Height="15" Stretch="Uniform"
                    Data="M14 2 H5 V17 M8 7 H17 V22 H8 Z"
                    Stroke="{Binding $parent[Button].Foreground}"
                    StrokeThickness="0.7"/>
            </Button>
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Content="Export Markdown…" Command="{Binding ExportCommand}"
                VerticalAlignment="Top" FontSize="10" Padding="6,1" />
      </Grid>

      <!-- conversation detail is rendered as HTML in the platform webview
           (re-built via MainWindow code-behind whenever Entries/CurrentSession change) -->
      <Panel Grid.Row="1">
        <!-- invisible until a session is selected: the native control paints about:blank
             as a gray box on some platforms, which would sit behind the empty-state text -->
        <NativeWebView x:Name="DetailWebView"
                       IsVisible="{Binding CurrentSession, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        <TextBlock Text="Select a conversation" FontSize="14" Opacity="0.6"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding CurrentSession, Converter={x:Static ObjectConverters.IsNull}}"/>
      </Panel>

      <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" Margin="0,6,0,0"
                   IsVisible="{Binding IsLoading}"/>
    </Grid>
  </Grid>
</Window>
